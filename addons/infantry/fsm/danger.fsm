            init = "_deadline=time+([_this,""ASSESS"",_selected] call WAIT_fnc_DangerEngineAct);";
            precondition = "";
            class Links {class Wait {itemno=33; priority=0; to="Waiting"; precondition=""; condition="true"; action="";};};
        };
        class Waiting
        {
            name = "Waiting";
            itemno = 8;
            init = "";
            precondition = "";
            class Links
            {
                class Interrupted {itemno=34; priority=4; to="Finished"; precondition=""; condition="!([_this] call WAIT_fnc_DangerEngineCanContinue)"; action="";};
                class Saturated {itemno=35; priority=2; to="Queued"; precondition=""; condition="count _queue > 3"; action="";};
                class Done {itemno=36; priority=0; to="Recycle"; precondition=""; condition="time >= _deadline"; action="";};
            };
        };
        class Recycle
        {
            name = "Recycle";
            itemno = 9;
            init = "_followUp=[_this,_mode,_selected] call WAIT_fnc_DangerEngineRecycle; if (_followUp isNotEqualTo []) then {_queue pushBack _followUp};";
            precondition = "";
            class Links
            {
                class Interrupted {itemno=37; priority=3; to="Finished"; precondition=""; condition="!([_this] call WAIT_fnc_DangerEngineCanContinue)"; action="";};
                class Drain {itemno=38; priority=1; to="Queued"; precondition=""; condition="count _queue > 0"; action="";};
                class Done {itemno=39; priority=0; to="Finished"; precondition=""; condition="true"; action="";};
