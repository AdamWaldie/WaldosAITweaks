class FSM {
 fsmName="WAIT server support request";
 class States {
  class Start {name="Start";init="_job=_this param [0,createHashMap]; _generation=_this param [1,-1]; _brain=_this param [2,createHashMap]; _requester=_brain getOrDefault [""requester"",grpNull]; _phase=toUpperANSI (_brain getOrDefault [""phase"",""DISCOVER""]); _reason="""";";precondition="";class Links {class Invalid {priority=5;to="Finished";condition="!isServer || {isNull _requester} || {count _job == 0} || {count _brain == 0}";action="_reason=""INVALID_START"";";};class Route {priority=0;to="Router";condition="true";action="";};};};
  class Router {name="Router";init="_phase=toUpperANSI (_brain getOrDefault [""phase"",""DISCOVER""]);";precondition="";class Links {
   class FinishedJob {priority=12;to="Finished";condition="_brain getOrDefault [""finished"",false]";action="_reason=_brain getOrDefault [""cancelReason"",""COMPLETE""];";};
   class Cancelled {priority=11;to="Finished";condition="_brain getOrDefault [""cancelled"",false]";action="_reason=_brain getOrDefault [""cancelReason"",""CANCELLED""];";};
   class Replaced {priority=10;to="Finished";condition="isNull _requester || {_generation != (_requester getVariable [""WAIT_Support_BrainGeneration"",-2])} || {(_requester getVariable [""WAIT_Support_Brain"",createHashMap]) isNotEqualTo _brain}";action="_reason=""REPLACED"";";};
   class Delay {priority=9;to="Delay";condition="time < (_brain getOrDefault [""nextAt"",time])";action="";};
   class Reserve {priority=5;to="Reserve";condition="_phase == ""RESERVE""";action="";};
   class Coordinate {priority=5;to="Coordinate";condition="_phase == ""COORDINATE""";action="";};
   class Discover {priority=0;to="Discover";condition="true";action="";};
  };};
  class Delay {name="Delay";init="";precondition="";class Links {class Invalidated {priority=5;to="Router";condition="_brain getOrDefault [""cancelled"",false] || {_brain getOrDefault [""finished"",false]} || {isNull _requester} || {_generation != (_requester getVariable [""WAIT_Support_BrainGeneration"",-2])}";action="";};class Due {priority=0;to="Router";condition="time >= (_brain getOrDefault [""nextAt"",time])";action="";};};};
  class Discover {name="Discover";init="[_requester,_generation,_brain,""DISCOVER""] call WAIT_fnc_SupportRequestQueue;";precondition="";class Links {class Wait {priority=0;to="Waiting";condition="true";action="";};};};
  class Reserve {name="Reserve";init="[_requester,_generation,_brain,""RESERVE""] call WAIT_fnc_SupportRequestQueue;";precondition="";class Links {class Wait {priority=0;to="Waiting";condition="true";action="";};};};
  class Coordinate {name="Coordinate";init="[_requester,_generation,_brain,""COORDINATE""] call WAIT_fnc_SupportRequestQueue;";precondition="";class Links {class Wait {priority=0;to="Waiting";condition="true";action="";};};};
  class Waiting {name="Waiting";init="";precondition="";class Links {class Invalidated {priority=6;to="Finished";condition="_brain getOrDefault [""cancelled"",false] || {isNull _requester} || {_generation != (_requester getVariable [""WAIT_Support_BrainGeneration"",-2])} || {(_requester getVariable [""WAIT_Support_Brain"",createHashMap]) isNotEqualTo _brain}";action="_reason=_brain getOrDefault [""cancelReason"",""INVALIDATED""];";};class SchedulerWatchdog {priority=5;to="Router";condition="(_brain getOrDefault [""pending"",false]) && {!(_brain getOrDefault [""completed"",false])} && {time >= ((_brain getOrDefault [""queuedAt"",time])+3)}";action="_brain set [""pending"",false]; _brain set [""watchdogCount"",(_brain getOrDefault [""watchdogCount"",0])+1]; _brain set [""nextAt"",time]; missionNamespace setVariable [""WAIT_AIPass_NextJobDue"",time];";};class Completed {priority=0;to="Router";condition="_brain getOrDefault [""completed"",false]";action="";};};};
  class Finished {name="Finished";init="_brain set [""finished"",true]; if (_reason != """") then {_brain set [""cancelReason"",_reason]}; if (!isNull _requester && {(_requester getVariable [""WAIT_Support_Brain"",createHashMap]) isEqualTo _brain}) then {_requester setVariable [""WAIT_Support_Brain_State"",[_phase,_generation,serverTime,_brain getOrDefault [""cancelReason"",""COMPLETE""]],true]; _requester setVariable [""WAIT_Support_Brain"",nil]; _requester setVariable [""WAIT_Support_Brain_FSM"",nil];};";precondition="";class Links {};};
 };
 initState="Start";finalStates[]={"Finished"};
};
