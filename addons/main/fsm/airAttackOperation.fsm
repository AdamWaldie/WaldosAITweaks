class FSM {
 fsmName="WAIT owner-local aircraft attack operation";
 class States {
  class Start {name="Start";init="_aircraft=_this param [0,objNull]; _generation=_this param [1,-1]; _brain=_this param [2,createHashMap]; _phase=_brain getOrDefault [""phase"",""PLAN""]; _reason="""";";precondition="";class Links {class Invalid {priority=5;to="Finished";condition="isNull _aircraft || {!local _aircraft} || {count _brain == 0}";action="_reason=""INVALID_START"";";};class Route {priority=0;to="Router";condition="true";action="";};};};
  class Router {name="Router";init="_phase=toUpperANSI (_brain getOrDefault [""phase"",""PLAN""]);";precondition="";class Links {
   class FinishedJob {priority=12;to="Finished";condition="_brain getOrDefault [""finished"",false]";action="_reason=_brain getOrDefault [""cancelReason"",""FINISHED""];";};
   class Cancelled {priority=11;to="Finished";condition="_brain getOrDefault [""cancelled"",false]";action="_reason=_brain getOrDefault [""cancelReason"",""CANCELLED""];";};
   class OwnershipLost {priority=10;to="Finished";condition="isNull _aircraft || {!local _aircraft}";action="_reason=""OWNERSHIP_LOST"";";};
   class Replaced {priority=9;to="Finished";condition="_generation != (_aircraft getVariable [""WAIT_AirAttack_BrainGeneration"",-2]) || {(_aircraft getVariable [""WAIT_AirAttack_Brain"",createHashMap]) isNotEqualTo _brain}";action="_reason=""REPLACED"";";};
   class Delay {priority=8;to="Delay";condition="time < (_brain getOrDefault [""nextAt"",time])";action="";};
   class Ingress {priority=5;to="Ingress";condition="_phase == ""INGRESS""";action="";};
   class Attack {priority=5;to="Attack";condition="_phase == ""ATTACK""";action="";};
   class Egress {priority=5;to="Egress";condition="_phase == ""EGRESS""";action="";};
   class Plan {priority=0;to="Plan";condition="true";action="";};
  };};
  class Delay {name="Delay";init="";precondition="";class Links {class Invalidated {priority=5;to="Router";condition="_brain getOrDefault [""cancelled"",false] || {_brain getOrDefault [""finished"",false]} || {isNull _aircraft} || {!local _aircraft} || {_generation != (_aircraft getVariable [""WAIT_AirAttack_BrainGeneration"",-2])}";action="";};class Due {priority=0;to="Router";condition="time >= (_brain getOrDefault [""nextAt"",time])";action="";};};};
  class Plan {name="Plan";init="[_aircraft,_generation,_brain,""PLAN""] call WAIT_fnc_AirAttackOperationQueue;";precondition="";class Links {class Wait {priority=0;to="Waiting";condition="true";action="";};};};
  class Ingress {name="Ingress";init="[_aircraft,_generation,_brain,""INGRESS""] call WAIT_fnc_AirAttackOperationQueue;";precondition="";class Links {class Wait {priority=0;to="Waiting";condition="true";action="";};};};
  class Attack {name="Attack";init="[_aircraft,_generation,_brain,""ATTACK""] call WAIT_fnc_AirAttackOperationQueue;";precondition="";class Links {class Wait {priority=0;to="Waiting";condition="true";action="";};};};
  class Egress {name="Egress";init="[_aircraft,_generation,_brain,""EGRESS""] call WAIT_fnc_AirAttackOperationQueue;";precondition="";class Links {class Wait {priority=0;to="Waiting";condition="true";action="";};};};
  class Waiting {name="Waiting";init="";precondition="";class Links {class Invalidated {priority=5;to="Finished";condition="_brain getOrDefault [""cancelled"",false] || {isNull _aircraft} || {!local _aircraft} || {_generation != (_aircraft getVariable [""WAIT_AirAttack_BrainGeneration"",-2])}";action="_reason=_brain getOrDefault [""cancelReason"",""INVALIDATED""];";};class Completed {priority=0;to="Router";condition="_brain getOrDefault [""completed"",false]";action="";};};};
  class Finished {name="Finished";init="_brain set [""finished"",true]; if (_reason != """") then {_brain set [""cancelReason"",_reason]}; if (!isNull _aircraft && {local _aircraft}) then {[_aircraft,""AIR_ATTACK"",_brain getOrDefault [""flightLeaseToken"",""""],_brain getOrDefault [""cancelReason"",""FINISHED""]] call WAIT_fnc_FlightLeaseRelease}; if (!isNull _aircraft && {local _aircraft} && {(_aircraft getVariable [""WAIT_AirAttack_Brain"",createHashMap]) isEqualTo _brain}) then {_aircraft setVariable [""WAIT_AirAttack_Brain_State"",[_phase,_generation,serverTime,_brain getOrDefault [""cancelReason"",""FINISHED""]],true]; _aircraft setVariable [""WAIT_AirAttack_Brain"",nil]; _aircraft setVariable [""WAIT_AirAttack_Brain_FSM"",nil];};";precondition="";class Links {};};
 };
 initState="Start";finalStates[]={"Finished"};
};
