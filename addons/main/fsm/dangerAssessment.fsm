class FSM {
    fsmName = "WAIT danger assessment";
    class States {
        class Start {
            name = "Start";
            init = "_group = _this param [0,grpNull]; _epoch = _this param [1,-1]; _generation = _this param [2,-1]; _delay = -1; _nextAt = time; _zeusToken = +(_group getVariable [""WAIT_AIPass_ZeusHold"",[]]);";
            precondition = "";
            class Links { class Assess { priority = 0; to = "Assessment"; condition = "true"; action = ""; }; };
        };
        class Assessment {
            name = "Assessment";
            init = "_delay = [_group,_epoch,_generation] call WAIT_fnc_DangerStep; _nextAt = time + (_delay max 0);";
            precondition = "";
            class Links {
                class Done { priority = 2; to = "Finished"; condition = "_delay < 0"; action = ""; };
                class Wait { priority = 0; to = "Waiting"; condition = "true"; action = ""; };
            };
        };
        class Waiting {
            name = "Waiting"; init = ""; precondition = "";
            class Links {
                class Interrupted {
                    priority = 2; to = "Finished";
                    condition = "isNull _group || {!local _group} || {_epoch != (_group getVariable [""WAIT_AIPass_Epoch"",0])} || {_generation != (_group getVariable [""WAIT_Danger_Generation"",0])} || {!(missionNamespace getVariable [""WAIT_AIPass_Active"",false])} || {_zeusToken isNotEqualTo (_group getVariable [""WAIT_AIPass_ZeusHold"",[]])} || {_group getVariable [""WAIT_AIPass_ZeusWaypoints"",false]} || {[_group] call WAIT_fnc_CortexExternalTakeover}";
                    action = "";
                };
                class Due { priority = 0; to = "Assessment"; condition = "time >= _nextAt"; action = ""; };
            };
        };
        class Finished {
            name = "Finished";
            init = "if (!isNull _group && {local _group} && {_epoch == (_group getVariable [""WAIT_AIPass_Epoch"",0])} && {_generation == (_group getVariable [""WAIT_Danger_Generation"",0])}) then {[leader _group,""RELEASE""] call WAIT_fnc_DangerReact; _group setVariable [""WAIT_Danger_FSM"",nil]; _group setVariable [""WAIT_Danger_Events"",nil]; _group setVariable [""WAIT_Danger_Response"",nil,true]; _group setVariable [""WAIT_Danger_Action"",nil,true]; _job=_group getVariable [""WAIT_Cortex_GroupJob"",createHashMap]; if (count _job > 0) then {_job deleteAt ""responsiveUntil""}};";
            precondition = ""; class Links {};
        };
    };
    initState = "Start"; finalStates[] = {"Finished"};
};
